{
  "name": "ClassSnag",
  "description": "Watch VirtuaGym classes for openings and automatically request a booking when a spot becomes available.",
  "version": "1.1.0",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png",
    "32": "assets/icon-32.png"
  },
  "permissions": [
    "storage",
    "tabGroups",
    "notifications",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.virtuagym.com/*"
  ],
  "action": {
    "default_title": "ClassSnag - Auto-book fitness classes",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png",
      "32": "assets/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.virtuagym.com/classes*"
      ],
      "js": [
        "jquery.min.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/bell.wav"
      ],
      "matches": [
        "https://*.virtuagym.com/*"
      ]
    }
  ],
  "manifest_version": 3,
  "minimum_chrome_version": "116"
}
