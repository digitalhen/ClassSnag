{
  "name": "ClassSnag",
  "description": "Automatically book fitness classes on VirtuaGym as soon as they become available. Never miss your favorite class again!",
  "version": "1.0.0",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "tabGroups"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.virtuagym.com/*"
  ],
  "action": {
    "default_title": "ClassSnag - Auto-book fitness classes",
    "default_icon": "assets/icon-128.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [ "https://*.virtuagym.com/classes*" ],
      "js": [
        "jquery.min.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [ "assets/mask.png" ],
      "matches": [ "https://*.virtuagym.com/*" ]
    }
  ],
  "manifest_version": 3
}
